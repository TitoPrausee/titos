#!/usr/bin/env bash
# titos-iso-make — baut die titOS ISO (braucht root + archiso)
# Multi-Arch: x86_64 (linux-zen, Gaming) + aarch64 (linux-aarch64, ohne Gaming-Stack).
#   sudo ./bin/titos-iso-make              # Architektur des Hosts
#   sudo ARCH=aarch64 ./bin/titos-iso-make # ARM64 explizit (auf ARM-Host)
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# titOS-Quellen überschreibbar (CI: Repo-Root statt iso/titos-Staging)
TITOS_SRC="${TITOS_SRC:-$SRC/titos}"
PROFILE="/var/tmp/titos-iso-profile"
WORK="/var/tmp/titos-iso-work-$(date +%s)"
OUT="${OUT:-$SRC/out}"
ARCH="${ARCH:-$(uname -m)}"
LIVE_USER="titos"
LIVE_USER_PW="titos"

[[ $EUID -eq 0 ]] || { echo "Bitte mit sudo ausführen (mkarchiso braucht root)."; exit 1; }
[[ "$ARCH" == "x86_64" || "$ARCH" == "aarch64" ]] || { echo "Unsupported ARCH=$ARCH (nur x86_64|aarch64)"; exit 1; }

# aarch64-Bau auf x86-Host: braucht qemu-user-static + binfmt (nur für chroot-Paketzugriff;
# mkarchiso kann das nicht emuliert — deshalb ARM-ISO nur auf ARM-Host bauen!)
if [[ "$ARCH" != "$(uname -m)" ]]; then
    echo "! WARNUNG: Cross-Build ($ARCH auf $(uname -m)) wird nicht unterstützt —"
    echo "  die ARM-ISO bitte auf einem ARM64-Host bauen (z.B. GitHub Actions ubuntu-*-arm)."
    exit 1
fi

if [[ "$ARCH" == "x86_64" ]]; then
    KERNEL="linux-zen"
else
    KERNEL="linux-aarch64"
    if [[ ! -e /etc/pacman.d/alarm-mirrorlist && ! -f "$SRC/pacman-aarch64.conf" ]]; then
        echo "! aarch64 braucht ALARM-Repo-Zugriff (pacman-aarch64.conf liegt im Profil)"
    fi
fi

echo ":: Räume auf ..."
# Hängende proc/sys/dev-Mounts aus früheren Läufen lösen (kein /dev/fd nötig)
for m in $(awk -v w="$WORK" '$2 ~ w {print $2}' /proc/mounts); do umount -l "$m" 2>/dev/null || true; done
rm -rf "$WORK" || true
mkdir -p "$PROFILE" "$OUT"

echo ":: Kopiere archiso releng Basisprofil ..."
cp -a /usr/share/archiso/configs/releng/. "$PROFILE/"

echo ":: Overlaye titOS Profil (packages.$ARCH, airootfs) ..."
rsync -a "$SRC/packages.$ARCH" "$PROFILE/packages.$ARCH"
rsync -a "$SRC/airootfs/" "$PROFILE/airootfs/"

if [[ "$ARCH" == "aarch64" ]]; then
    echo ":: ALARM-Repo-Konfig (Arch Linux ARM mirrors) ..."
    cp "$SRC/pacman-aarch64.conf" "$PROFILE/pacman.conf"

    echo ":: Boot-Einträge auf linux-aarch64 umbiegen ..."
    for f in $(grep -rl 'vmlinuz-linux' "$PROFILE" 2>/dev/null || true); do
        sed -i \
            -e 's/vmlinuz-linux/vmlinuz-linux-aarch64/g' \
            -e 's/initramfs-linux\.img/initramfs-linux-aarch64.img/g' \
            "$f"
    done
else
    echo ":: Kernel -> linux-zen umbiegen (x86_64) ..."
    for f in $(grep -rl 'vmlinuz-linux' "$PROFILE" 2>/dev/null || true); do
        sed -i \
            -e 's/vmlinuz-linux-zen/vmlinuz-linux/g' \
            -e 's/vmlinuz-linux/vmlinuz-linux-zen/g' \
            -e 's/initramfs-linux\.img/initramfs-linux-zen.img/g' \
            "$f"
    done

    # mkinitcpio preset: linux.preset -> linux-zen.preset
    PRESET_DIR="$PROFILE/airootfs/etc/mkinitcpio.d"
    if [[ -f "$PRESET_DIR/linux.preset" && ! -f "$PRESET_DIR/linux-zen.preset" ]]; then
        mv "$PRESET_DIR/linux.preset" "$PRESET_DIR/linux-zen.preset"
        sed -i \
            -e 's/initramfs-linux\.img/initramfs-linux-zen.img/g' \
            -e 's/vmlinuz-linux/vmlinuz-linux-zen/g' \
            "$PRESET_DIR/linux-zen.preset"
    fi
fi

echo ":: ISO-Beschriftung auf titOS setzen ..."
sed -i "s/^iso_name=.*/iso_name=\"titOS\"/"                          "$PROFILE/profiledef.sh"
sed -i "s/^iso_label=.*/iso_label=\"TITOS_\$(date +%Y%m)\"/"          "$PROFILE/profiledef.sh"
sed -i "s/^iso_application=.*/iso_application=\"titOS Live-Installer (AI-Powered Gaming Linux)\"/" "$PROFILE/profiledef.sh"
sed -i "s|^iso_publisher=.*|iso_publisher=\"titOS <https://github.com/TitoPrausee/titOS>\"|" "$PROFILE/profiledef.sh"

echo ":: Tote Memtest-Einträge entfernen (Paket nicht in der Liste) ..."
rm -f "$PROFILE"/efiboot/loader/entries/03-*memtest*.conf \
      "$PROFILE"/syslinux/*memtest*.cfg 2>/dev/null || true

echo ":: Live-User ${LIVE_USER} anlegen (autologin), root-Passwort sperren ..."
HASH="$(openssl passwd -6 "$LIVE_USER_PW")"
if ! grep -q "^${LIVE_USER}:" "$PROFILE/airootfs/etc/passwd" 2>/dev/null; then
    echo "${LIVE_USER}:x:1000:1000:titOS Live:/home/${LIVE_USER}:/bin/zsh" >> "$PROFILE/airootfs/etc/passwd"
    echo "${LIVE_USER}:${HASH}::0:99999:7:::" >> "$PROFILE/airootfs/etc/shadow"
    echo "${LIVE_USER}:x:1000:" >> "$PROFILE/airootfs/etc/group"
fi
sed -i 's/^root::/root:!*:/' "$PROFILE/airootfs/etc/shadow" || true

# Passwortlose sudo für den Live-User (nur Live-Umgebung)
mkdir -p "$PROFILE/airootfs/etc/sudoers.d"
printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$LIVE_USER" \
    > "$PROFILE/airootfs/etc/sudoers.d/titos-live"
chmod 440 "$PROFILE/airootfs/etc/sudoers.d/titos-live"

# Home-Verzeichnis über tmpfiles sicherstellen (uid wird erst im Build gesetzt)
mkdir -p "$PROFILE/airootfs/etc/tmpfiles.d"
printf 'd /home/%s 0700 %s %s -\n' "$LIVE_USER" "$LIVE_USER" "$LIVE_USER" \
    > "$PROFILE/airootfs/etc/tmpfiles.d/titos-live.conf"

echo ":: Live-Installer installieren ..."
mkdir -p "$PROFILE/airootfs/usr/local/bin" "$PROFILE/airootfs/usr/lib/titos-iso/install"
install -m 755 "$SRC/install/run.sh"             "$PROFILE/airootfs/usr/local/bin/titos-install"
install -m 755 "$SRC/install/chroot-stage-a.sh"  "$PROFILE/airootfs/usr/lib/titos-iso/install/"
install -m 755 "$SRC/install/chroot-stage-b.sh"  "$PROFILE/airootfs/usr/lib/titos-iso/install/"
rsync -a --delete "$TITOS_SRC/" "$PROFILE/airootfs/usr/lib/titos-iso/titos/"
chmod +x "$PROFILE/airootfs/usr/lib/titos-iso/live-boot-hint"

echo ":: Live-Hinweis-Service aktivieren ..."
mkdir -p "$PROFILE/airootfs/etc/systemd/system/multi-user.target.wants"
ln -sfn /usr/lib/systemd/system/titos-live.service \
    "$PROFILE/airootfs/etc/systemd/system/multi-user.target.wants/titos-live.service"

echo ":: Serial-Console (ttyS0) für Headless-VM-Tests / Server-Betreuung ..."
mkdir -p "$PROFILE/airootfs/etc/systemd/system/serial-getty@ttyS0.service.d"
cat > "$PROFILE/airootfs/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf" <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-f titos' --keep-baud 115200,38400,9600 %I $TERM
EOF
mkdir -p "$PROFILE/airootfs/etc/systemd/system/getty.target.wants"
ln -sfn /usr/lib/systemd/system/serial-getty@.service \
    "$PROFILE/airootfs/etc/systemd/system/getty.target.wants/serial-getty@ttyS0.service"

# console= Kernel-Parameter in Bootloader-Einträge (systemd-boot + syslinux)
for f in $(grep -rl '^options ' "$PROFILE" --include='*.conf' 2>/dev/null | grep -iv 'systemd/[a-z]*\.conf$' || true); do
    sed -i 's/^options /options console=tty0 console=ttyS0,115200 /' "$f"
done
for f in $(grep -rl '^APPEND ' "$PROFILE" 2>/dev/null || true); do
    sed -i 's/^APPEND /APPEND console=tty0 console=ttyS0,115200 /' "$f"
done

echo ":: Baue ISO (mkarchiso, kernel=$KERNEL) ..."
mkarchiso -v -w "$WORK" -o "$OUT" "$PROFILE"

rm -rf "$WORK"

echo ""
echo "════════════════════════════════════════════"
echo "  ISO gebaut ($ARCH): $OUT"
echo "════════════════════════════════════════════"
ls -lh "$OUT"
(cd "$OUT" && sha256sum *.iso > "$(ls -1t *.iso | head -1).sha256") || true